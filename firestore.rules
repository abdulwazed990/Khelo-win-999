rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "mohammadabdulwazed1@gmail.com" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin') ||
         request.auth != null);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'username', 'balance']) &&
             data.uid is string &&
             data.name is string && data.name.size() <= 100 &&
             data.username is string && data.username.size() <= 50 &&
             data.balance is number;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['uid', 'name', 'username', 'balance']) &&
             data.uid is string &&
             data.name is string &&
             data.username is string &&
             data.balance is number;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['uid', 'type', 'method', 'amount', 'status', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.type in ['deposit', 'withdraw'] &&
             data.method in ['nagad', 'bkash', 'rocket'] &&
             data.amount is number && data.amount > 0 &&
             data.status == 'pending';
    }

    function isValidBet(data) {
      return data.keys().hasAll(['uid', 'gameName', 'amount', 'profit', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.gameName is string &&
             data.amount is number &&
             data.profit is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUserUpdate(request.resource.data);
    }

    match /usernames/{username} {
      allow get: if true; // Allow lookup for login
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidTransaction(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bets/{betId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidBet(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Public read for site content, Admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /home_ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{methodDocId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || isAdmin() || true;
      allow update, delete: if isAdmin();
    }

    match /system_meta/{metaId} {
      allow read: if true;
      allow write: if true;
    }

    // Aviator Signal collections
    match /signal_tokens/{token} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /signal_rounds/{roundId} {
      allow read: if true;
      allow write: if true; // Allow live game engine to publish round telemetry and admin to control
    }

    match /signal_connections/{connectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /signal_users/{userId} {
      allow read, write: if isAdmin();
    }

    match /signal_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

