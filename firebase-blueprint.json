{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and balance information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "balance": { "type": "number" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "welcomeBonusClaimed": { "type": "boolean" },
        "captchaInvalidUntil": { "type": "string", "format": "date-time" },
        "lastCaptchaDate": { "type": "string", "format": "date" }
      },
      "required": ["uid", "name", "username", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Deposit and withdrawal records.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "method": { "type": "string", "enum": ["nagad", "bkash", "rocket"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "senderNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "type", "method", "amount", "status", "createdAt"]
    },
    "Bet": {
      "title": "Bet",
      "description": "Game betting history.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "gameName": { "type": "string" },
        "amount": { "type": "number" },
        "profit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "gameName", "amount", "profit", "createdAt"]
    },
    "Username": {
      "title": "Username",
      "description": "Mapping of username to email for login.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email", "uid"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional carousel banners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["title", "imageUrl", "active", "order"]
    },
    "Game": {
      "title": "Game",
      "description": "Game directory entries.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "provider": { "type": "string" },
        "imageUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "route": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "maintenance"] },
        "order": { "type": "number" }
      },
      "required": ["name", "category", "provider", "imageUrl", "route", "status", "order"]
    },
    "Category": {
      "title": "Category",
      "description": "Game categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "slug", "order", "active"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Promotional bonuses and campaigns.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "bonusText": { "type": "string" },
        "imageUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["title", "description", "bonusText", "imageUrl", "active", "order"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Live scrolling marquee announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["text", "active"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Site global branding and links.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "supportEnabled": { "type": "boolean" }
      },
      "required": ["brandName"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Username to email mapping."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "All transactions."
    },
    "/bets/{betId}": {
      "schema": "Bet",
      "description": "All betting records."
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Cover and promotional banners."
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Game catalog cards."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Game category filters."
    },
    "/promotions/{promoId}": {
      "schema": "Promotion",
      "description": "Promotional campaigns."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Marquee announcements."
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Site global configuration."
    }
  }
}

